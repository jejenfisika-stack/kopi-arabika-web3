# Salin file ini ke .env.local lalu isi nilainya. JANGAN commit .env.local.

# RPC Polygon Amoy untuk cek duplikat on-chain (route: /api/cek-duplikat).
# Jika kosong, fallback ke RPC publik https://rpc-amoy.polygon.technology
ALCHEMY_RPC_URL=

# Kredensial Pinata (IPFS) untuk route: /api/upload-ipfs
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY=rose-casual-warbler-710.mypinata.cloud
